# LLM-DB Phase 1 — runtime configuration
# Copy this file to .env and edit as needed.
# Shell env vars always override values set here.
# Lines starting with # are comments; blank lines are ignored.

# ---------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------
# mock      — offline demo: use canned decompositions from
#             examples/sample_queries.json. No Ollama required.
# live      — call a local Ollama model for real decompositions,
#             using examples/sample_queries.json as the query set.
# orgaccess — pull test queries live from the HuggingFace dataset
#             respai-lab/orgaccess and run each through the pipeline.
LLMDB_MODE=mock

# ---------------------------------------------------------------------------
# Ollama model (ignored in mock mode)
# ---------------------------------------------------------------------------
# Any model you have pulled locally via `ollama pull <model>`.
# Swapping models requires no code changes — just edit this line.
LLMDB_OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# OrgAccess dataset settings (only used when LLMDB_MODE=orgaccess)
# ---------------------------------------------------------------------------
# Which difficulty splits to pull (comma-separated). All three, any two,
# or just one. Rows from all selected splits are pooled before sampling.
#   LLMDB_ORGACCESS_SPLITS=easy,medium,hard   # all splits
#   LLMDB_ORGACCESS_SPLITS=easy,hard          # two splits
#   LLMDB_ORGACCESS_SPLITS=easy               # single split
LLMDB_ORGACCESS_SPLITS=easy

# (Deprecated) singular alias kept for backward compatibility.
# Use LLMDB_ORGACCESS_SPLITS above instead.
# LLMDB_ORGACCESS_SPLIT=easy

# Total number of rows to sample across ALL selected splits (leave blank for
# no cap = full dataset). The sample is drawn AFTER pooling and shuffling, so
# you get a uniform random mix across splits.
# Start small (e.g. 20) before running the full ~75k-row dataset.
LLMDB_ORGACCESS_LIMIT=20

# Random seed for cross-split shuffling. Set to an integer (e.g. 42) for
# reproducible runs; leave blank for a different random sample each run.
LLMDB_ORGACCESS_RANDOM_SEED=

# Which user id (from config/users.yaml) to run OrgAccess queries as.
# OrgAccess has its own permission model — treat this as the Phase 1 role
# being stress-tested. Most queries will be REJECTED or PARTIAL.
LLMDB_ORGACCESS_USER=daniel.finance_manager

# ---------------------------------------------------------------------------
# Excel report (optional — leave blank to skip report generation)
# ---------------------------------------------------------------------------
# Path for the .xlsx output file. Parent directories are created automatically.
# The report contains one row per query with verdict breakdown, denied
# resources, and the OrgAccess expected response for later comparison.
LLMDB_REPORT_PATH=reports/orgaccess_report.xlsx
